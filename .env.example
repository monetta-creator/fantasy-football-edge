# Optional: OpenRouter key for LLM-written rationales (open-source models). Leave blank to use deterministic text.
OPENROUTER_API_KEY=
# OpenRouter model id (cheap + fast default). Alternatives: google/gemini-3.8-flash, qwen/qwen3.8-max-0902
OPENROUTER_MODEL=z-ai/glm-5.3-flash
# Vision model for "Import board photo" (reads a Yahoo draft-board screenshot). glm-5.3-flash also accepts images.
OPENROUTER_VISION_MODEL=google/gemini-3.8-flash

# Draft sim count per candidate (300 ~ 1s per recommendation on an M-series Mac)
SIM_COUNT=300
# Set true if the Yahoo league's IR slots are labelled "IR+" (then "Out" players are IR-eligible)
IR_PLUS=false

# Phase 1 (Yahoo OAuth) — fill in after creating the Yahoo developer app
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
